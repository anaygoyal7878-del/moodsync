// MoodSync data model.
//
// Scale notes: `biometric_readings` is the table that grows unbounded with
// user count and wearable sync frequency. In production this is a strong
// candidate for time-based partitioning (e.g. pg_partman by month) and a
// retention/rollup policy that ages raw readings out into `insights` after
// N days — that's an operational migration, not a Prisma schema change, so
// it isn't modeled here, but `@@index([userId, timestamp])` is chosen with
// that partitioning key in mind.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens        RefreshToken[]
  wearableConnections  WearableConnection[]
  smartHomeConnections SmartHomeConnection[]
  automationRules      AutomationRule[]
  biometricReadings    BiometricReading[]
  insights             Insight[]
  recommendations      Recommendation[]
  automationLogs       AutomationExecutionLog[]
  notifications        Notification[]
  pendingNotificationDigestEntries PendingNotificationDigestEntry[]
  pendingDeviceCommands PendingDeviceCommand[]
  resourcePauses       ResourcePause[]
  musicPlayLogs        MusicPlayLog[]
  locationEvents       LocationEvent[]
  meditationSessions   MeditationSession[]
  caffeineLogs         CaffeineLog[]
  focusSessions        FocusSession[]
  appleMusicConnection AppleMusicConnection?
  calendarConnection   CalendarConnection?
  preferences          UserPreferences?
  homeSnapshot         HomeSnapshot?

  @@map("users")
}

/// Our own session refresh tokens (JWT auth), unrelated to third-party
/// OAuth tokens below. Only a hash is ever stored — the raw token exists
/// only in the client's possession.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum WearableProvider {
  WHOOP
  GOOGLE_HEALTH
  GARMIN
  APPLE_HEALTH
  AMAZFIT
}

enum SmartHomeProvider {
  HUE
  SPOTIFY
  ECOBEE
  ALEXA
  HOMEKIT
  /// Direct Bluetooth LE control of Hue bulbs running in Bluetooth-only
  /// mode (no Hue Bridge) — a different provider from HUE (the official
  /// cloud Remote API, which requires a Bridge and is unreachable
  /// without one). Never creates a SmartHomeConnection row, same as
  /// HOMEKIT — see docs/HUE_BLE_ARCHITECTURE.md.
  HUE_BLE
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
  NOT_YET_AVAILABLE
}

/// Third-party OAuth credentials. Access/refresh tokens are AES-256-GCM
/// encrypted at the application layer (backend/src/lib/crypto.ts) before
/// insert — this table only ever holds ciphertext + nonce, never plaintext.
/// One row belongs to exactly one connection (wearable XOR smart home),
/// enforced by the unique FK on each connection table rather than a
/// polymorphic reverse relation.
model OAuthToken {
  id                       String   @id @default(uuid())
  accessTokenCiphertext    Bytes
  accessTokenNonce         Bytes
  refreshTokenCiphertext   Bytes?
  refreshTokenNonce        Bytes?
  /// Generic slot for a third encrypted secret some providers issue
  /// alongside the OAuth pair — e.g. Philips Hue's long-lived
  /// `hue-application-key`, which functions as a credential and gets the
  /// same encryption-at-rest treatment as the access/refresh tokens
  /// rather than living in a connection's plaintext `metadata` JSON.
  providerSecretCiphertext Bytes?
  providerSecretNonce      Bytes?
  scope                    String
  expiresAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  wearableConnection  WearableConnection?
  smartHomeConnection SmartHomeConnection?
  calendarConnection  CalendarConnection?

  @@map("oauth_tokens")
}

model WearableConnection {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       WearableProvider
  providerUserId String?
  status         ConnectionStatus @default(ACTIVE)
  oauthTokenId   String?          @unique
  oauthToken     OAuthToken?      @relation(fields: [oauthTokenId], references: [id], onDelete: SetNull)
  lastSyncedAt   DateTime?
  /// Device name/battery fields are nullable because only some providers'
  /// APIs expose them — confirmed present for Google Health (Fitbit) via
  /// `users.pairedDevices` (batteryLevel/batteryStatus/deviceVersion);
  /// confirmed ABSENT from WHOOP's public API (no battery endpoint exists
  /// in their documented resource categories). See
  /// docs/INTEGRATIONS_RESEARCH.md.
  deviceName     String?
  /// 0-100, or null if the provider doesn't expose it.
  batteryLevel   Int?
  /// Provider's own battery status string (e.g. Fitbit's High/Medium/Low/Empty),
  /// kept as free text rather than an enum since it's provider-specific.
  batteryStatus  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, provider])
  @@index([provider, status])
  @@map("wearable_connections")
}

model SmartHomeConnection {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          SmartHomeProvider
  providerAccountId String?
  status            ConnectionStatus  @default(ACTIVE)
  oauthTokenId      String?           @unique
  oauthToken        OAuthToken?       @relation(fields: [oauthTokenId], references: [id], onDelete: SetNull)
  /// Provider-specific non-secret metadata, e.g. { "bridgeId": "..." } for
  /// Hue or { "activeDeviceId": "..." } for Spotify.
  metadata          Json              @default("{}")
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  connectedDevices ConnectedDevice[]

  @@unique([userId, provider])
  @@index([provider, status])
  @@map("smart_home_connections")
}

/// Deliberately NOT a SmartHomeConnection + OAuthToken pair like every
/// other provider — Apple's MusicKit issues a "Music User Token" via
/// client-side MusicKit JS authorization (no server-side OAuth redirect
/// exists for it at all), and that token has no fixed expiry Apple
/// documents, unlike OAuthToken's non-nullable `expiresAt`. Forcing a
/// fabricated expiry onto it to fit the shared table would be modeling
/// something Apple never actually told us, so this gets its own minimal
/// table instead — one row per user, the encrypted token plus enough
/// metadata to know whether it's still connected. See
/// docs/APPLE_MUSIC_ARCHITECTURE.md.
model AppleMusicConnection {
  id                       String           @id @default(uuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                   ConnectionStatus @default(ACTIVE)
  musicUserTokenCiphertext Bytes
  musicUserTokenNonce      Bytes
  /// Apple Music storefront/region code (e.g. "us") returned alongside
  /// the user token — catalog searches are storefront-scoped.
  storefront               String?
  lastSyncedAt             DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@map("apple_music_connections")
}

/// Read-only Google Calendar connection — the only calendar integration
/// in this codebase (Adaptive Study Planner, Stress Timeline, Burnout
/// Detection, Social Battery all read from this). Standard OAuth pair,
/// same shape as WearableConnection/SmartHomeConnection, but a distinct
/// model since calendar is a genuinely third domain — not a wearable,
/// not a smart-home device. See docs/GOOGLE_CALENDAR_INTEGRATION.md.
model CalendarConnection {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         ConnectionStatus @default(ACTIVE)
  oauthTokenId   String?          @unique
  oauthToken     OAuthToken?      @relation(fields: [oauthTokenId], references: [id], onDelete: SetNull)
  lastSyncedAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("calendar_connections")
}

model ConnectedDevice {
  id                    String              @id @default(uuid())
  smartHomeConnectionId String
  smartHomeConnection   SmartHomeConnection @relation(fields: [smartHomeConnectionId], references: [id], onDelete: Cascade)
  externalDeviceId      String
  name                  String
  deviceType            String
  room                  String?
  isOnline              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([smartHomeConnectionId, externalDeviceId])
  @@map("connected_devices")
}

/// One row per normalized reading per provider sync. See
/// shared/src/wearables.ts for the field-availability-by-provider notes —
/// every metric field here is nullable because no provider fills all of
/// them.
model BiometricReading {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             WearableProvider
  timestamp            DateTime
  heartRate            Float?
  restingHeartRate     Float?
  /// Milliseconds (SDNN). Apple Health-only today.
  heartRateVariability Float?
  /// Breaths per minute. Apple Health-only today.
  respiratoryRate      Float?
  /// 0-100 percentage (SpO2). Apple Health-only today.
  bloodOxygen          Float?
  sleepScore           Float?
  /// Minutes of deep/slow-wave sleep. WHOOP + Google Health/Fitbit only —
  /// see NormalizedBiometricReading in shared/src/wearables.ts.
  deepSleepMinutes     Float?
  /// Minutes of REM sleep. Same provenance as deepSleepMinutes.
  remSleepMinutes      Float?
  /// Minutes of light sleep. Same provenance as deepSleepMinutes.
  lightSleepMinutes    Float?
  recoveryScore        Float?
  stressLevel          Float?
  activityLevel        Float?
  steps                Int?
  calories             Float?
  /// Minutes of at-or-above-moderate activity intensity. Google Health-only
  /// today (`active-minutes` data type) — see
  /// integrations/fitbit/src/normalize.ts and its doc comments on
  /// confidence level (not independently verified against a live account).
  activeMinutes        Float?
  /// Total minutes in an elevated heart-rate zone. Google Health-only
  /// today (`time-in-heart-rate-zone` data type). Same confidence caveat
  /// as activeMinutes.
  heartRateZoneMinutes Float?
  createdAt            DateTime         @default(now())

  // Frequent-polling providers (e.g. Fitbit heart-rate samples on a
  // 5-minute worker cadence) can re-fetch a data point already inserted
  // by a previous run when its lookback window overlaps — this constraint
  // lets bulkInsert use skipDuplicates instead of accumulating repeats.
  @@unique([userId, provider, timestamp])
  @@index([userId, timestamp])
  @@map("biometric_readings")
}

model AutomationRule {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean  @default(true)
  /// RuleCondition[] from shared/src/automation.ts, ANDed together
  conditions      Json
  /// AutomationAction[] from shared/src/automation.ts
  actions         Json
  cooldownMinutes Int      @default(30)
  /// 0-100, default 50 — resolves conflicts when two matched rules target
  /// the same resource in one dispatch pass (see ai/src/dispatch.ts's
  /// `resourceKeyFor`). Rules that never collide with another are
  /// unaffected by this value.
  priority        Int      @default(50)
  /// TimeWindow ({start, end} "HH:mm") from shared/src/automation.ts, or
  /// null for a purely biometric-triggered rule. Schedule-triggered
  /// templates (Focus Mode, Sleep Preparation) rely on this alongside an
  /// empty `conditions` array — see docs/DECISION_ENGINE_ARCHITECTURE.md.
  timeWindow      Json?
  /// Per-rule notification opt-off — see AutomationRuleDefinition in
  /// shared/src/automation.ts. Distinct from UserPreferences.notificationsEnabled
  /// (account-wide); this silences just this rule's notifications while
  /// its AutomationExecutionLog audit trail keeps recording regardless.
  notificationsEnabled Boolean @default(true)
  /// Optional geofence trigger — see docs/GEOFENCING_ARCHITECTURE.md and
  /// ai/src/dispatch.ts's dispatchForLocationEvent. Null for every
  /// existing (biometric/schedule-triggered) rule.
  locationTrigger LocationEventType?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executionLogs AutomationExecutionLog[]

  @@index([userId, enabled])
  @@map("automation_rules")
}

enum ExecutionOutcome {
  EXECUTED
  SKIPPED_COOLDOWN
  SKIPPED_DISABLED
  /// Lost a same-resource conflict to a higher-priority rule matched in
  /// the same dispatch pass — see ai/src/dispatch.ts.
  SKIPPED_CONFLICT
  /// The user had automations paused (UserPreferences.automationsPausedUntil)
  /// at dispatch time.
  SKIPPED_MANUAL_PAUSE
  /// Hit the per-user hourly action-execution rate limit — a safety check,
  /// not a user preference (see ai/src/dispatch.ts's RATE_LIMIT constant).
  SKIPPED_SAFETY_RATE_LIMIT
  /// A homekit.* action can't execute server-side at all — queued as a
  /// PendingDeviceCommand for the iOS companion app instead. Distinct
  /// from EXECUTED because dispatch genuinely doesn't know the outcome
  /// yet (see ai/src/dispatch.ts, docs/HOMEKIT_ARCHITECTURE.md).
  QUEUED_FOR_DEVICE
  /// A homekit.security_control action was matched but
  /// UserPreferences.securityControlEnabled is false — distinct from
  /// SKIPPED_DISABLED (that's a whole rule disabled) since only the
  /// security-control action itself was blocked, not the rule. See
  /// docs/HOME_SCENES_ARCHITECTURE.md.
  SKIPPED_SECURITY_CONTROL_DISABLED
  FAILED
}

model AutomationExecutionLog {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId           String
  rule             AutomationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggerReadingId String?
  outcome          ExecutionOutcome
  failureReason    String?
  /// Human-readable explainability text (ai/src/explain.ts) — why this
  /// outcome happened, in terms of the actual reading values / conflict /
  /// pause / rate limit involved. Null for rows logged before this field
  /// existed.
  reason           String?
  executedAt       DateTime         @default(now())

  @@index([userId, executedAt])
  @@index([ruleId, executedAt])
  @@map("automation_execution_logs")
}

/// A real, persisted, explainable notification — the notification engine
/// described in docs/DECISION_ENGINE_ARCHITECTURE.md. Generated
/// automatically for every dispatch outcome (not just a dedicated
/// notification action type), reusing the same `reason` text stored on
/// `AutomationExecutionLog`.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  ruleId    String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@map("notifications")
}

enum PendingDeviceCommandStatus {
  PENDING
  EXECUTED
  FAILED
}

/// A HomeKit action dispatch couldn't execute server-side — HomeKit has
/// no cloud API, only the native framework running on the user's own
/// device (see docs/HOMEKIT_ARCHITECTURE.md) — so this is the queue the
/// iOS companion app polls (GET /api/devices/pending-commands) and
/// reports back to (POST .../:id/complete) the next time it's opened.
/// Same "device polls server" shape as Apple Health's ingest, inverted:
/// there the device pushes data up, here the device pulls commands down.
model PendingDeviceCommand {
  id            String                     @id @default(uuid())
  userId        String
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      SmartHomeProvider
  /// AutomationAction from shared/src/automation.ts — today always a
  /// `homekit.activate_scene` action, kept as the general shape in case
  /// a second device-polled provider is ever added.
  action        Json
  ruleId        String?
  status        PendingDeviceCommandStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime                   @default(now())
  completedAt   DateTime?

  @@index([userId, status, createdAt])
  @@map("pending_device_commands")
}

/// Cached snapshot of the user's primary Apple Home, pushed by the iOS
/// companion app (HomeKitController.swift's fetchHomeSnapshot()) — the
/// backend can never query HomeKit directly (no cloud API exists at
/// all, see docs/HOMEKIT_ARCHITECTURE.md), so this is the same "device
/// pushes full state, backend caches the latest copy" shape as Apple
/// Health ingest. Replaced wholesale on every push (delete+recreate
/// children in a transaction), not diffed incrementally — see
/// docs/HOME_SCENES_ARCHITECTURE.md.
model HomeSnapshot {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeId String
  homeName String
  /// Matter accessories added via Apple Home appear as ordinary
  /// HMAccessory objects — there is no third-party "Matter detection"
  /// API. This field currently always reads false; kept as an honest
  /// placeholder rather than fabricated detection logic. See
  /// docs/HOME_SCENES_ARCHITECTURE.md's sourcing table.
  isMatterHome Boolean @default(false)
  pushedAt DateTime @default(now())

  rooms       HomeRoomSnapshot[]
  zones       HomeZoneSnapshot[]
  accessories HomeAccessorySnapshot[]
  scenes      HomeSceneSnapshot[]

  @@map("home_snapshots")
}

model HomeRoomSnapshot {
  id             String       @id @default(uuid())
  homeSnapshotId String
  homeSnapshot   HomeSnapshot @relation(fields: [homeSnapshotId], references: [id], onDelete: Cascade)
  roomId         String
  name           String
  temperatureC   Float?
  humidityPct    Float?
  /// Raw HMCharacteristicValueAirQuality string, if any accessory in the
  /// room exposes one — null for most rooms, no sensor present.
  airQuality     String?

  @@index([homeSnapshotId])
  @@map("home_room_snapshots")
}

model HomeZoneSnapshot {
  id             String       @id @default(uuid())
  homeSnapshotId String
  homeSnapshot   HomeSnapshot @relation(fields: [homeSnapshotId], references: [id], onDelete: Cascade)
  zoneId         String
  name           String
  roomIds        String[]

  @@index([homeSnapshotId])
  @@map("home_zone_snapshots")
}

enum HomeAccessoryCategory {
  LOCK
  GARAGE_DOOR
  ALARM_SYSTEM
  SMOKE_DETECTOR
  LEAK_SENSOR
  WINDOW_COVERING
  DOORBELL
  OUTLET_OR_SWITCH
  LIGHT
  THERMOSTAT_OR_SENSOR
  OTHER
}

model HomeAccessorySnapshot {
  id              String                @id @default(uuid())
  homeSnapshotId  String
  homeSnapshot    HomeSnapshot          @relation(fields: [homeSnapshotId], references: [id], onDelete: Cascade)
  accessoryId     String
  name            String
  roomId          String?
  category        HomeAccessoryCategory
  /// From the accessory's "Accessory Information" service — real,
  /// public, third-party-readable per HomeKit's HMAccessory API.
  manufacturer    String?
  model           String?
  firmwareVersion String?
  reachable       Boolean
  batteryLevelPct Int?
  /// Coarse status string, category-dependent (e.g. "locked"/"unlocked",
  /// "closed"/"open", "armed_away"/"disarmed") — deliberately a loose
  /// string, not a typed enum per category, since HomeKit's characteristic
  /// value sets vary by accessory and over-modeling them risks
  /// fabricating a taxonomy Apple doesn't publish. Security/safety
  /// characteristic read access is not independently confirmed this
  /// session — see docs/HOME_SCENES_ARCHITECTURE.md.
  statusValue         String?
  /// True for LOCK | GARAGE_DOOR | ALARM_SYSTEM — gates whether this
  /// accessory can ever appear in a security-control command, alongside
  /// UserPreferences.securityControlEnabled.
  isSecurityAccessory Boolean @default(false)

  @@index([homeSnapshotId])
  @@map("home_accessory_snapshots")
}

model HomeSceneSnapshot {
  id             String       @id @default(uuid())
  homeSnapshotId String
  homeSnapshot   HomeSnapshot @relation(fields: [homeSnapshotId], references: [id], onDelete: Cascade)
  sceneId        String
  name           String
  accessoryIds   String[]
  /// MoodSync's own concept, not a HomeKit-native flag — pushed back up
  /// on each snapshot so it survives a replace.
  isFavorite     Boolean   @default(false)
  lastRunAt      DateTime?
  runCount       Int       @default(0)

  @@index([homeSnapshotId])
  @@map("home_scene_snapshots")
}

enum InsightPeriod {
  DAILY
  WEEKLY
}

model Insight {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      InsightPeriod
  /// e.g. "sleepScore", "recoveryScore", "automationEffectiveness"
  metric      String
  periodStart DateTime
  periodEnd   DateTime
  value       Float
  /// Signed delta vs. the prior comparable period
  trend       Float?
  summary     String?
  createdAt   DateTime      @default(now())

  @@index([userId, period, periodStart])
  @@map("insights")
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

model Recommendation {
  id               String               @id @default(uuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String
  /// { templateId: string } pointing at a RuleForm.tsx rule template —
  /// not a raw AutomationAction[] blueprint, since a Hue action needs a
  /// concrete deviceId this heuristic (ai/src/recommendations.ts) has no
  /// way to know. See docs/DECISION_ENGINE_ROADMAP.md's Recommendations
  /// entry.
  suggestedActions Json
  status           RecommendationStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  respondedAt      DateTime?

  @@index([userId, status])
  @@map("recommendations")
}

/// One row per real spotify.play_playlist action execution — see
/// ai/src/spotifyActionExecutor.ts. likedSignal starts null and is set
/// by workers/src/spotifyPlaybackCheckWorker.ts a few minutes later: a
/// skip-detection *proxy* (still the same context playing = true, moved
/// on = false), not a certain "did the user like this" signal — see the
/// worker's doc comment. Feeds ai/src/recommendations.ts's third
/// heuristic (suggest changing a playlist that gets skipped often).
model MusicPlayLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId       String
  playlistUri  String
  playedAt     DateTime @default(now())
  likedSignal  Boolean?

  @@index([userId, playlistUri])
  @@index([likedSignal, playedAt])
  @@map("music_play_logs")
}

model UserPreferences {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursStart        String?
  quietHoursEnd          String?
  notificationsEnabled   Boolean   @default(true)
  automationsEnabled     Boolean   @default(true)
  /// Manual override: when set and in the future, dispatch skips every
  /// rule with SKIPPED_MANUAL_PAUSE rather than checking conditions at
  /// all — the dashboard's "Pause automations for 1 hour" control. Unlike
  /// `automationsEnabled` (a standing preference), this is a temporary,
  /// self-expiring override — see docs/DECISION_ENGINE_ARCHITECTURE.md.
  automationsPausedUntil DateTime?
  preferredUnits         String    @default("imperial")
  /// IMMEDIATE (default, unchanged prior behavior): every dispatch
  /// outcome that passes shouldNotify writes a Notification row right
  /// away. HOURLY: outcomes queue into PendingNotificationDigestEntry
  /// instead, and workers/src/notificationDigestWorker.ts batches each
  /// user's queued entries into one combined Notification per run.
  notificationDigestMode NotificationDigestMode @default(IMMEDIATE)
  /// Disabled by default. When false, neither the backend (dispatch.ts)
  /// nor the iOS companion (DeviceCommandCoordinator) will ever act on a
  /// homekit.security_control action — the backend refuses to queue one
  /// (logs SKIPPED_SECURITY_CONTROL_DISABLED instead) and the companion
  /// app independently refuses to execute one even if it somehow found
  /// its way into the queue. Flipping this on is the only way
  /// security-accessory control (locks/garage/alarm) ever activates.
  securityControlEnabled Boolean @default(false)
  /// User-set free-text location (e.g. "Austin, TX"), resolved once via
  /// Open-Meteo's geocoding API into weatherLat/weatherLng below — see
  /// docs/WEATHER_INTEGRATION.md. Null means no location set; weather
  /// features (Music Intelligence's "Rainy Day" category, Smart
  /// Notifications) simply don't fire rather than guessing a location.
  weatherLocationName    String?
  weatherLat             Float?
  weatherLng             Float?
  /// User's preferred bedroom temperature range for sleep, in Celsius —
  /// backs the "bedroom is warmer than your preferred sleep range" smart
  /// notification (compares against HomeRoomSnapshot.temperatureC for
  /// the room named "Bedroom"/matching sleepRoomName). Both null means
  /// the notification never fires — no fabricated default range.
  sleepTempMinC          Float?
  sleepTempMaxC          Float?
  updatedAt              DateTime  @updatedAt

  @@map("user_preferences")
}

enum NotificationDigestMode {
  IMMEDIATE
  HOURLY
}

/// A per-provider manual override, alongside UserPreferences.automationsPausedUntil
/// (which pauses everything). resourceKey is a SmartHomeProviderId string
/// (e.g. "hue") -- provider-level granularity, matching how a user
/// actually thinks about it ("pause my lights"), not per-action-type. See
/// ai/src/dispatch.ts's per-action pause check in dispatchForReading.
model ResourcePause {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceKey String
  pausedUntil DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, resourceKey])
  @@map("resource_pauses")
}

/// Queued notification content awaiting the next
/// workers/src/notificationDigestWorker.ts run — only written to when a
/// user's notificationDigestMode is HOURLY (see ai/src/notificationExecutor.ts's
/// deliverNotification). Consumed and deleted once batched into a real
/// Notification row.
model PendingNotificationDigestEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  ruleId    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("pending_notification_digest_entries")
}

enum LocationEventType {
  ARRIVED
  DEPARTED
}

/// ARRIVED/DEPARTED a user's one geofenced "home" region, pushed by
/// LocationController.swift in the iOS companion app — see
/// docs/GEOFENCING_ARCHITECTURE.md. No coordinate is ever stored, only
/// the boolean crossing event, consumed by
/// ai/src/dispatch.ts's dispatchForLocationEvent.
model LocationEvent {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LocationEventType
  occurredAt DateTime
  createdAt  DateTime          @default(now())

  @@index([userId, occurredAt])
  @@map("location_events")
}

/// A completed guided-timer meditation session, logged client-side when
/// the countdown reaches zero (see frontend's LuxuryMeditation.tsx) —
/// there is no server-side timer to enforce this, same trust model as
/// every other client-reported wellness action in this app. `ambience`
/// names one of the Web Audio-synthesized soundscapes the session
/// played (rain/forest/ocean/noise), or null if played in silence; it's
/// not a claim about a licensed audio track, just which generator ran.
model MeditationSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  ambience        String?
  startedAt       DateTime
  completedAt     DateTime @default(now())

  @@index([userId, completedAt])
  @@map("meditation_sessions")
}

/// First manual wellness-event log in this codebase — no provider exposes
/// caffeine intake, so this is user-typed, same client-reported trust
/// model as MeditationSession's completedAt. Feeds the Live Energy
/// Meter's temporary-boost-that-decays component (see ai/src/energyMeter.ts).
/// `mg` is caffeine content in milligrams, not drink volume — the client
/// converts a drink-type pick (coffee/tea/energy drink/etc.) to an
/// approximate mg value before posting, so the server only ever stores
/// one real, comparable unit.
model CaffeineLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mg        Int
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("caffeine_logs")
}

/// A completed Focus Session — same client-reported trust model as
/// MeditationSession (client-side timer only, logged only on natural
/// completion, never on early stop/reset — see that model's comment).
/// `focusScore` is computed server-side at completion time from heart
/// rate stability during [startedAt, completedAt] (see
/// ai/src/focusScore.ts) — null when too few heart rate samples existed
/// in that window to compute one, never guessed. Distraction-detection
/// and notification-silencing were explicitly scoped out for this
/// round (no public API exists for a third-party app to silence
/// notifications, and no distraction signal exists) — this model only
/// ever represents "a focus timer ran," not "focus was verified."
model FocusSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  startedAt       DateTime
  completedAt     DateTime @default(now())
  focusScore      Int?

  @@index([userId, completedAt])
  @@map("focus_sessions")
}
